{
    "name": "cywolf/nlp-tools",
    "version": "2.0.0",
    "type": "typo3-cms-extension",
    "description": "Natural Language Processing tools for TYPO3 with language detection, stemming, stop words filtering, and text clustering",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Wolfangel Cyril",
            "email": "cyril.wolfangel@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4 || ^13.0 || ^14.0",
        "wamania/php-stemmer": "^3.0 || ^4.0"
    },
    "require-dev": {
        "typo3/testing-framework": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Cywolf\\NlpTools\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cywolf\\NlpTools\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "nlp_tools"
        }
    }
}